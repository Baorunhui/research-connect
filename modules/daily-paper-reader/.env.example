# Daily Paper Reader 本地调试环境变量模板
# 复制为 `.env` 后填写真实值；`.env` 已被 `.gitignore` 忽略，不会同步到 GitHub。

# ===== 基础运行 =====
# 可固定一次本地运行日期，便于复现 archive 路径；留空则使用当天 UTC 日期。
# DPR_RUN_DATE=20260521

# 如需临时使用另一份配置文件，可指向本地私有 YAML；留空则读取 `config.yaml`。
# DPR_CONFIG_FILE=config.local.yaml

# ===== LLM / 总结模型 =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 兼容摘要链路的变量名；不填时多数脚本会回退到 DEEPSEEK_*。
SUMMARY_API_KEY=
SUMMARY_BASE_URL=
SUMMARY_MODEL=
LLM_PRIMARY_BASE_URL=

# ===== Reranker =====
# 预设（默认远程优先）：public-zwwen-rerank（公益端点，免配置）/ public-sinksilk-rerank（sinksilk 中转）/ siliconflow-qwen3-0.6b / local-qwen3-0.6b（本地 GPU）
# 也可以在站点「本地服务设置」面板里切换，面板选择会覆盖这里（保存即生效，无需重启）。
# 注意：sinksilk 的 rerank 模型名是 `qwen3-reranker`（new-api channel 名），不是 SiliconFlow 的 `Qwen/Qwen3-Reranker-0.6B`；
# 其渠道不接受 top_n 参数，客户端已改为不传并自行截断（2026-08-29 实测 200 OK）。
RERANK_PROFILE=public-zwwen-rerank
# 留空：provider/model 由 RERANK_PROFILE 推断（推荐）；填了会覆盖 profile。
RERANK_PROVIDER=
LOCAL_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANK_MODEL=
RERANK_API_KEY=
# sinksilk yum 中转站 rerank 端点（使用 public-sinksilk-rerank 预设时生效）
RERANK_API_BASE_URL=https://api.sinksilk.com:58443/v1/rerank
SILICONFLOW_API_KEY=
SILICONFLOW_RERANK_URL=

# ===== 召回模式（默认云端 Supabase；local = arXiv API 增量 + 本地 FTS5/embedding，零 Supabase 依赖）=====
# 通常不用动：面板「召回模式」切换会写 config.yaml local.recall.mode，优先级高于这里。
# DPR_RECALL_MODE=supabase
# 本地召回的 embedding 源：默认 openai = 复用问答端点的 /v1/embeddings（如中转站的 qwen3-embedding），
# 无需安装任何本地模型；仅当端点无 embeddings 且你想用本地 bge-small 兜底时才需要
# pip install -r requirements-local-models.txt（含 torch，体积较大，初始配置不必装）。
# DPR_LOCAL_EMBED_PROVIDER=openai
# DPR_LOCAL_EMBED_MODEL=qwen3-embedding
# DPR_LOCAL_EMBED_BASE_URL=
# DPR_LOCAL_EMBED_API_KEY=
# DPR_LOCAL_EMBED_DEVICE=cpu

# 公益 embedding / rerank 服务：如需回退到 zwwen 公益 reranker，可在这里覆盖 base_url 并填 PUBLIC_RERANK_API_KEY。
DPR_EMBED_API_URL=https://zwwen.online/embed
DPR_EMBED_API_KEY=
# 默认不自动安装/加载本地 Torch 模型；仅当远程 embedding 不可用且已安装 requirements-local-models.txt 时再开启。
DPR_EMBED_ALLOW_LOCAL_FALLBACK=0
PUBLIC_RERANK_API_KEY=
PUBLIC_RERANK_API_BASE_URL=https://api.sinksilk.com:58443/v1/rerank

# ===== Supabase 本地维护/同步 =====
# 只做只读召回时通常使用 config.yaml 内的 publishable/anon key 即可。
# 需要执行 maintain/sync.py 或 cleanup.py 时，在本地 `.env` 填 service key，千万不要提交。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_BACKEND_KEY=arxiv
SUPABASE_PAPERS_TABLE=arxiv_papers
SUPABASE_BM25_RPC=match_arxiv_papers_bm25
SUPABASE_VECTOR_RPC=match_arxiv_papers
SUPABASE_VECTOR_RPC_EXACT=match_arxiv_papers_exact
SUPABASE_SYNC_TABLE=arxiv_sync_status

# 控制本地 arXiv Supabase 召回开关；不填则沿用 config.yaml。
# DPR_ARXIV_ENABLED=1
# DPR_ARXIV_USE_BM25_RPC=1
# DPR_ARXIV_USE_VECTOR_RPC=1

# ===== 多源后端本地覆盖示例 =====
# 这些变量只会覆盖本地进程环境，不会写回 config.yaml。
# DPR_ENABLE_BIORXIV_BACKEND=1
# DPR_BIORXIV_URL=
# DPR_BIORXIV_ANON_KEY=
# DPR_BIORXIV_PAPERS_TABLE=biorxiv_papers
# DPR_BIORXIV_BM25_RPC=match_biorxiv_papers_bm25
# DPR_BIORXIV_VECTOR_RPC=match_biorxiv_papers_exact

# ===== OpenReview 抓取可选登录 =====
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# ===== MinerU 云端图表抽取（可选）=====
# 用于图表抽取对照评估 / 备用抽取路径；在 https://mineru.net/apiManage 生成。
# MINERU_API_TOKEN=
# MINERU_API_BASE=https://mineru.net
# 默认使用 vlm 后端（表格/公式识别最佳）；可选 vlm / pipeline。
# MINERU_MODEL_VERSION=vlm
# 轮询间隔与超时（秒）。
# MINERU_POLL_INTERVAL=5
# MINERU_POLL_TIMEOUT=900

# ===== Docling 整图提取（可选，图片默认优先走它）=====
# 日报 ensure_paper_media 会先尝试 Docling 整图提取（替换原 caption-render，避免
# DocLayout-YOLO 把 composite figure 拆成多个子图），空/失败再回落 papercropper→pymupdf。
# 推荐用 scripts/setup_docling.sh 一键搭建并自动写到这里（会建独立 .venv-docling）。
# 手动指定时，填一个装了 docling 的 python 路径（Windows 用 Scripts/python.exe）。
# DOCLING_PYTHON=
# 置 1 可整体关闭 Docling 提取。
# DPR_DISABLE_DOCLING=0
# Docling 子进程超时（秒，默认 1500）。
# DOCLING_TIMEOUT_SECONDS=1500

# ===== Jina 全文抓取（可选，论文详细总结/图表解读的正文上下文来源之一）=====
# 日报 generate_deep_summary 会先请求 https://r.jina.ai/<pdf_url> 拿结构化 Markdown 作为 .txt；
# 失败再回退到 PyMuPDF 抽取 PDF 全文。r.jina.ai 国内常超时，可在此调短或关闭。
# 单次请求超时秒数（默认 15）。
# DPR_JINA_TIMEOUT=15
# 最大重试次数（默认 3，置 0 等同于关闭 Jina）。
# DPR_JINA_MAX_RETRIES=3
# 置 1 整体关闭 Jina，直接走 PyMuPDF 兜底。
# DPR_JINA_DISABLED=0

# ===== 调试开关 =====
# 设为 1 可禁用自动加载 `.env`。
# DPR_DISABLE_DOTENV=1
# 指定其它 env 文件路径。
# DPR_DOTENV_PATH=/absolute/path/to/.env.local

# ===== 本地服务（local_server.py）=====
# local.chat.api_key 留空时，从这里读取 DEEPSEEK_API_KEY 作为 AI 问答 Key；
# 也可直接在 config.yaml 的 local.chat.api_key 填写（仅本机，不提交）。

# ===== DeepXiv（综述外部召回，可选） =====
# DeepXiv 学术数据服务（主力源 arXiv 预印本）：综述的外部语义检索补充路（被引数 + 周级新鲜度）。
# 注意：综述默认主路已是 Kaggle 本地快照（零网络零限流），DeepXiv 默认关闭——
# 前端勾选「DeepXiv 外部检索」或 payload 传 use_deepxiv=true 时才启用。
# 免费档自动注册 token 1000 次/天（pip install deepxiv-sdk 后跑一次任意命令自动获取）；
# 网页注册 key 10000 次/天。不配置时综述自动降级为本地库 + 种子引文直取（arXiv API 免 token）。
# 资源：API 文档 https://data.rag.ac.cn/api/docs | Token 管理 https://data.rag.ac.cn/token-lookup | 服务监控 https://data.rag.ac.cn/status
# DEEPXIV_TOKEN=
# DEEPXIV_API_BASE_URL=https://data.rag.ac.cn
# DEEPXIV_TIMEOUT=30

# ===== Kaggle arXiv 快照（综述大规模粗筛路，可选） =====
# Cornell-University/arxiv 官方元数据快照（~250 万篇）本地 FTS5 粗筛：零网络、无限流，
# 综述可先词法宽筛上万候选，再由本地 bge 语义粗排收窄。与 DeepXiv（语义检索）互补：
# Kaggle 全历史稳定覆盖、周级滞后；DeepXiv 新鲜、带被引数。
# 认证二选一：KAGGLE_API_TOKEN（Kaggle → Account → Settings → API 的新式 KGAT 单 token）
# 或 KAGGLE_USERNAME + KAGGLE_KEY（传统 kaggle.json 内容）。免费账号即可。
# 构建：python scripts/build_kaggle_arxiv_index.py --download（首次下载 ~4GB，建库 15-45 分钟；
# 产物 archive/kaggle_arxiv/（JSON ~4GB + SQLite ~6-8GB，已 gitignore），建议每周重跑刷新）。
# KAGGLE_API_TOKEN=
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# 索引库路径（默认 archive/kaggle_arxiv/index.sqlite3）：
# DPR_SURVEY_KAGGLE_INDEX=archive/kaggle_arxiv/index.sqlite3
# 词法粗筛候选量（默认 10000，前端三档 3千/1万/3万）：
# DPR_SURVEY_KAGGLE_COARSE_TOP_K=10000
# 语义粗排后进 rerank 的池大小（默认 300）：
# DPR_SURVEY_EMBED_POOL=300

