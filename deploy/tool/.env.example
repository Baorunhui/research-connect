# Copy to deploy/tool/.env (gitignored) and fill in. Never commit real keys.

# OpenAI-compatible LLM shared by all three modules.
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=
LLM_MODEL=
# Optional: separate model for the XHS pipeline steps (defaults to LLM_MODEL).
XHS_MODEL=

# Container user; match the owner of deploy/tool/state (`id -u` / `id -g`).
RESEARCH_CONNECT_UID=1000
RESEARCH_CONNECT_GID=1000

# Host ports, bound to 127.0.0.1 only. The host reverse proxy targets GATEWAY_PORT.
GATEWAY_PORT=58888
DAILY_PAPER_PORT=58889
CITATIONCLAW_PORT=58890
XHS_PORT=58891

# Basic-auth login created by init.sh (random password when empty).
TOOL_BASIC_AUTH_USER=research
TOOL_BASIC_AUTH_PASSWORD=

# Optional HTTP proxy for outbound calls from the containers (Semantic Scholar,
# OpenAlex, arXiv ...), e.g. http://host.docker.internal:7890
OUTBOUND_PROXY=
# Optional proxy for `docker compose build` (build runs with host networking).
BUILD_HTTP_PROXY=

# Optional existing standalone CitationClaw data root (contains cache/*.json).
# Mounted read-only; its caches are imported once so finished lookups are reused.
LEGACY_CITATIONCLAW_DATA=

# Optional CitationClaw lightweight model tier (二次筛选/自引/格式化、画像报告、引文语境).
# Search/verification calls keep LLM_*. For a service on the host's 127.0.0.1 use
# http://host.docker.internal:<port>/v1.
CITATIONCLAW_LIGHT_BASE_URL=
CITATIONCLAW_LIGHT_API_KEY=
CITATIONCLAW_LIGHT_MODEL=

# Optional honor list directory for the CitationClaw quick report (default ./state/honor-list).
HONOR_LIST_DIR=

# OpenAlex citing lookup for the quick report. MAILTO joins the polite pool;
# ROUTE is auto (direct first, then OUTBOUND_PROXY) | direct | proxy.
OPENALEX_MAILTO=
OPENALEX_API_KEY=
OPENALEX_ROUTE=auto
OPENALEX_RPS=8
