# Feishu enterprise self-built application. No QR login is required.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu
FEISHU_REQUIRE_MENTION=true
# Optional comma-separated sender open_id allowlist. Empty means that Feishu's
# application availability scope is the access boundary.
FEISHU_ALLOWED_OPEN_IDS=

# OpenAI-compatible primary provider.
LLM_BASE_URL=https://api.llm.ustc.edu.cn/v1
LLM_API_KEY=replace-with-your-llm-key
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# Optional OpenAI-compatible fallback provider.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Optional. Default: ~/.research-connect/data/modules/connect-hub/state/connect_hub.sqlite3
CONNECT_HUB_DB_PATH=
CONNECT_HUB_HISTORY_MESSAGES=20
CONNECT_HUB_WORKERS=4
CONNECT_HUB_LOG_LEVEL=INFO

# Lightweight, keyless web enrichment. Exa uses its anonymous hosted MCP;
# Jina Reader fetches selected public URLs. Set provider=disabled to turn the
# capability off globally. Users can still choose auto/on/off per Feishu chat.
WEB_SEARCH_PROVIDER=exa_mcp
WEB_SEARCH_ENDPOINT=https://mcp.exa.ai/mcp?tools=web_search_exa
WEB_SEARCH_TIMEOUT_SECONDS=30
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_CACHE_HOURS=24
URL_FETCH_PROVIDER=jina
JINA_READER_ENDPOINT=https://r.jina.ai/

# Daily Paper remains a separate project. Start its paper_engine HTTP service
# locally, then enable this adapter. PUBLIC_URL is optional and must be a URL
# reachable by the Feishu user (localhost is not useful outside that machine).
DAILY_PAPER_TRANSPORT=disabled
DAILY_PAPER_ENDPOINT=
DAILY_PAPER_TIMEOUT_SECONDS=1800
DAILY_PAPER_POLL_SECONDS=3
DAILY_PAPER_PUBLIC_URL=
DAILY_PAPER_SKIP_LLM_REFINE=false
# Keep Daily Paper's own .env untouched. These values are injected per run.
# The default public zwwen endpoint avoids a separate SiliconFlow credential.
DAILY_PAPER_RERANK_PROFILE=public-zwwen-rerank
DAILY_PAPER_RERANK_PROVIDER=public_zwwen
DAILY_PAPER_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
DAILY_PAPER_RERANK_BASE_URL=https://zwwen.online/rerank
DAILY_PAPER_RERANK_API_KEY=

# Optional in this monorepo. Set only when using an external XHS Agent checkout.
XHS_AGENT_DIR=
XHS_AGENT_TIMEOUT_SECONDS=900
XHS_AGENT_OFFLINE=false
